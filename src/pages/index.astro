---
import About from '../components/home/About.astro';
import Cta from '../components/home/Cta.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  description="JD Window Repair and Restoration has been serving the Boston area for over 20 years."
  title="JD Window Repair and Restoration"
>
  <Hero />
  <Services />
  <About />
  <div class="relative">
    <!-- Image element -->
    <img
      class="h-auto w-full"
      width="1280"
      height="640"
      src="/assets/IMG_1310.jpg"
      alt="Hero picture"
    />

    <!-- Text overlay container -->
    <div class="absolute inset-0 flex items-end justify-end" style="right:0;bottom:0">
      <p class="bg-black rounded bg-opacity-50 p-4 font-decorative text-3xl font-bold text-white">
        Rebuilding a sash
      </p>
    </div>
  </div>
  <Testimonials />
  <Cta />
</Layout>
