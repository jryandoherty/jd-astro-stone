---
const services = [
  {
    step: '/assets/wrench.png',
    name: 'Repair',
    description: 'Let us repair your existing windows before you spend thousands replacing them.',
  },
  {
    step: '/assets/window-white.png',
    name: 'Restoration',
    description:
      'Even the oldest windows can be restored to their original beauty, and in the process, we can also enhance their functionality. Not to menttion, save you money!',
  },
  {
    step: '/assets/building.png',
    name: 'Historic Restoration',
    description:
      'If you own a historic building, we can preserve its historical significance, ensuring that your building remains true to its heritage.',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-12 sm:gap-16">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Services</h2>
      <div class="grid gap-8 lg:grid-cols-3">
        {
          services.map((service) => (
            <div class="flex flex-col gap-12 rounded-3xl  bg-brand-red px-6 py-8">
              <p class="text-center text-sm">
                <img src={service.step} alt="icon" class="services-icon m-auto" />
              </p>
              <div class="flex flex-col gap-4">
                <h3 class="text-center font-decorative text-5xl font-medium text-brand-white">
                  {service.name}
                </h3>
                <p class="text-base  text-brand-white sm:text-lg">{service.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
